{
  "name": "pawgate",
  "version": "1.1.6",
  "description": "PawGate — Smart kennelstyring",
  "author": {
    "name": "PawGate",
    "email": "hei@pawgate.no",
    "url": "https://pawgate.no"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "electron .",
    "dist:win": "electron-builder --win   --publish never",
    "dist:mac": "electron-builder --mac   --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "sync": "cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "build:android": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.pawgate.app",
    "productName": "PawGate",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "pawgate/public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PawGate",
      "uninstallDisplayName": "PawGate",
      "menuCategory": "PawGate",
      "runAfterFinish": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico"
    },
    "dmg": {
      "title": "PawGate"
    },
    "publish": {
      "provider": "github",
      "owner": "AdrianTheWizard",
      "repo": "pawgate-app"
    }
  }
}
